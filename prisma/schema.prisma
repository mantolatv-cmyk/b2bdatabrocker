// ═══════════════════════════════════════════
// B2B DATA BROKER — PRISMA SCHEMA (v2 Enhanced)
// ═══════════════════════════════════════════
// Schema completo com suporte a pgvector, radar de
// concorrentes, relatórios e métricas de uso.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ═══════════════════════════════════════════
// AUTENTICAÇÃO E ASSINATURAS
// ═══════════════════════════════════════════

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  passwordHash    String
  avatarUrl       String?
  tier            SubscriptionTier @default(FREE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  insights        Insight[]
  chatSessions    ChatSession[]
  alertPrefs      AlertPreference[]
  competitors     Competitor[]
  reports         Report[]
  customSources   CustomDataSource[]
  usageMetrics    UsageMetric[]

  @@map("users")
}

// ═══════════════════════════════════════════
// DADOS BRUTOS (COLETADOS PELOS AGENTES)
// ═══════════════════════════════════════════

enum DataSourceType {
  RSS
  API
  WEB_SCRAPE
  SOCIAL_MEDIA
  GOVERNMENT
}

model RawData {
  id              String         @id @default(cuid())
  sourceType      DataSourceType
  sourceUrl       String
  title           String?
  content         String         @db.Text
  rawMetadata     Json?
  collectedAt     DateTime       @default(now())
  processedAt     DateTime?
  isProcessed     Boolean        @default(false)
  isDiscarded     Boolean        @default(false)
  discardReason   String?

  vectorKnowledge VectorKnowledge?
  insights        InsightSource[]

  @@index([isProcessed, collectedAt])
  @@index([sourceType])
  @@map("raw_data")
}

// ═══════════════════════════════════════════
// BASE DE CONHECIMENTO VETORIAL (pgvector)
// ═══════════════════════════════════════════

model VectorKnowledge {
  id              String                       @id @default(cuid())
  rawDataId       String                       @unique
  content         String                       @db.Text
  summary         String?                      @db.Text
  embedding       Unsupported("vector(1536)")  // text-embedding-3-small = 1536 dims
  category        String?
  relevanceScore  Float?
  createdAt       DateTime                     @default(now())

  rawData         RawData                      @relation(fields: [rawDataId], references: [id])

  @@map("vector_knowledge")
}

// ═══════════════════════════════════════════
// INSIGHTS (GERADOS PELO AGENTE ANALISTA)
// ═══════════════════════════════════════════

enum InsightType {
  RISK_ALERT
  OPPORTUNITY
  TREND
  COMPETITIVE_MOVE
  REGULATORY_CHANGE
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Insight {
  id              String          @id @default(cuid())
  userId          String
  type            InsightType
  severity        InsightSeverity
  title           String
  summary         String          @db.Text
  analysis        String          @db.Text
  recommendation  String?         @db.Text
  confidence      Float           @default(0.0)
  isRead          Boolean         @default(false)
  isArchived      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  expiresAt       DateTime?

  user            User            @relation(fields: [userId], references: [id])
  sources         InsightSource[]
  tags            InsightTag[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, severity])
  @@map("insights")
}

model InsightSource {
  id              String   @id @default(cuid())
  insightId       String
  rawDataId       String

  insight         Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  rawData         RawData  @relation(fields: [rawDataId], references: [id])

  @@unique([insightId, rawDataId])
  @@map("insight_sources")
}

model InsightTag {
  id              String   @id @default(cuid())
  insightId       String
  tag             String

  insight         Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([tag])
  @@map("insight_tags")
}

// ═══════════════════════════════════════════
// CHATBOT RAG
// ═══════════════════════════════════════════

model ChatSession {
  id              String        @id @default(cuid())
  userId          String
  title           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  messages        ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id              String      @id @default(cuid())
  sessionId       String
  role            String      // "user" | "assistant" | "system"
  content         String      @db.Text
  metadata        Json?
  createdAt       DateTime    @default(now())

  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ═══════════════════════════════════════════
// PREFERÊNCIAS DE ALERTA
// ═══════════════════════════════════════════

model AlertPreference {
  id              String          @id @default(cuid())
  userId          String
  keywords        String[]
  sectors         String[]
  minSeverity     InsightSeverity @default(MEDIUM)
  emailEnabled    Boolean         @default(true)
  pushEnabled     Boolean         @default(false)
  webhookUrl      String?
  smsEnabled      Boolean         @default(false)
  smsPhone        String?

  user            User            @relation(fields: [userId], references: [id])

  @@map("alert_preferences")
}

// ═══════════════════════════════════════════
// STATUS DOS AGENTES
// ═══════════════════════════════════════════

enum AgentStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
}

model AgentRun {
  id              String      @id @default(cuid())
  agentName       String
  status          AgentStatus @default(IDLE)
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  itemsProcessed  Int         @default(0)
  errorMessage    String?
  metadata        Json?

  @@index([agentName, startedAt(sort: Desc)])
  @@map("agent_runs")
}

// ═══════════════════════════════════════════
// RADAR DE CONCORRENTES (v2)
// ═══════════════════════════════════════════

model Competitor {
  id              String               @id @default(cuid())
  userId          String
  name            String
  domain          String?
  cnpj            String?
  sector          String?
  trackingActive  Boolean              @default(true)
  createdAt       DateTime             @default(now())

  user            User                 @relation(fields: [userId], references: [id])
  snapshots       CompetitorSnapshot[]

  @@index([userId])
  @@map("competitors")
}

model CompetitorSnapshot {
  id              String     @id @default(cuid())
  competitorId    String
  snapshotType    String     // "website" | "social" | "news" | "registry"
  content         String     @db.Text
  diff            String?    @db.Text
  detectedAt      DateTime   @default(now())

  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, detectedAt(sort: Desc)])
  @@map("competitor_snapshots")
}

// ═══════════════════════════════════════════
// RELATÓRIOS PDF (v2)
// ═══════════════════════════════════════════

model Report {
  id              String   @id @default(cuid())
  userId          String
  title           String
  period          String
  type            String   // "weekly" | "monthly" | "custom"
  pdfUrl          String?
  generatedAt     DateTime @default(now())
  insightCount    Int      @default(0)
  summary         String?  @db.Text

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId, generatedAt(sort: Desc)])
  @@map("reports")
}

// ═══════════════════════════════════════════
// FONTES CUSTOMIZADAS (v2)
// ═══════════════════════════════════════════

model CustomDataSource {
  id              String    @id @default(cuid())
  userId          String
  name            String
  type            String    // "api" | "rss" | "webhook" | "csv"
  config          Json
  isActive        Boolean   @default(true)
  lastFetchAt     DateTime?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id])

  @@map("custom_data_sources")
}

// ═══════════════════════════════════════════
// MÉTRICAS DE USO / BILLING (v2)
// ═══════════════════════════════════════════

model UsageMetric {
  id              String   @id @default(cuid())
  userId          String
  metric          String   // "insights_generated" | "chat_messages" | "api_calls"
  count           Int      @default(0)
  period          String   // "2025-01"
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, metric, period])
  @@map("usage_metrics")
}
